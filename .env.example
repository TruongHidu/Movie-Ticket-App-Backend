# Copy file nay thanh .env roi dien gia tri that. KHONG commit file .env.

# ===== Database =====
DB_URL=jdbc:mysql://localhost:3306/movie_ticket_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Mail (Gmail SMTP - dung App Password) =====
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ===== JWT (chuoi ngau nhien >= 32 ky tu) =====
JWT_SECRET=your_jwt_secret_key_at_least_32_characters

# ===== VNPAY =====
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8081/api/payment/vnpay-return
VNPAY_ORDER_TYPE=movie_ticket

# ===== Firebase =====
# classpath:firebase-service-account.json (dat file trong src/main/resources)
# hoac file:D:/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# ===== Docker (chi dung cho docker-compose.yml) =====
# Duong dan file Firebase tren may chu, mac dinh /opt/secrets/firebase-service-account.json
# FIREBASE_KEY_FILE=/opt/secrets/firebase-service-account.json
